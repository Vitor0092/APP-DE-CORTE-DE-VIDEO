# ===== HypeCut =====
# Senha de acesso ao painel (só você)
ADMIN_PASSWORD=troque-esta-senha
# Chave aleatória para assinar o cookie de sessão
SECRET_KEY=troque-por-uma-string-longa-aleatoria
# URL pública onde a plataforma roda (necessária para OAuth e para o Instagram baixar o vídeo)
PUBLIC_BASE_URL=http://localhost:8000

# IA que escolhe os momentos virais e escreve títulos/legendas (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Transcrição local (faster-whisper): tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# Voz da narração (edge-tts, grátis). Outras: pt-BR-FranciscaNeural, pt-BR-ThalitaNeural
TTS_VOICE=pt-BR-AntonioNeural

# YouTube / Google Cloud (OAuth para postar + API key para descobrir vídeos em alta)
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok for Developers (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram (Meta for Developers, "Instagram API with Instagram Login", conta Business/Creator)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
